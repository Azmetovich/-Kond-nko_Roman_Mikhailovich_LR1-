<Window x:Class="Pizza.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каталог товаров" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="DarkOrange">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Каталог товаров"
                   FontSize="26"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0 0 0 20"/>
        <ListBox x:Name="ProductsList"
                 Grid.Row="1"
                 BorderThickness="0"
                 Background="Transparent">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0 0 0 10"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White"
                            BorderBrush="#D0D0D0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="100"
                                Height="100"
                                Background="#E8E8E8"
                                BorderBrush="#C5C5C5"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ClipToBounds="True">
                            <Image Source="{Binding ImagePath}"
                                Stretch="Fill"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="15 0 0 0">
                                <TextBlock Text="{Binding ProductName}"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                                <TextBlock Text="{Binding Description}"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           Margin="0 5 0 0"/>
                                <TextBlock Text="{Binding Ingredients}"
                                           FontSize="12"
                                           Foreground="Gray"
                                           TextWrapping="Wrap"
                                           Margin="0 5 0 0"/>
                                <TextBlock Text="{Binding PriceText}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Margin="0 5 0 0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0 15 0 0">
            <Button Content="Добавить в корзину"
                    Width="160"
                    Height="35"
                    Margin="5"
                    Click="BtnAddToCart_Click"/>
            <Button Content="Назад"
                    Width="120"
                    Height="35"
                    Margin="5"
                    Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</Window>