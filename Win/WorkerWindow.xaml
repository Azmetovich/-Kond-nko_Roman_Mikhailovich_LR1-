<Window x:Class="Pizza.WorkerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Окно сотрудника" Height="550" Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="DarkOrange">
    <Window.Resources>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0 6"/>
            <Setter Property="Background" Value="#E6E6E6"/>
            <Setter Property="BorderBrush" Value="#B5B5B5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property= "FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid>
        <StackPanel Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Height="565">
            <TextBlock Text=""
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#333333"
                       HorizontalAlignment="Center"
                       Margin="0 0 0 25"/>
            <Border Background="White"
                    BorderBrush="#CFCFCF"
                    BorderThickness="1"
                    Padding="18"
                    CornerRadius="12"
                    Margin="0 0 0 25">
                <StackPanel>
                    <TextBlock Text="Личная информация"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#333333"
                               HorizontalAlignment="Center"
                               Margin="0 0 0 18"/>
                    <Grid Margin="0 5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ФИО:"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Foreground="#333333"/>
                        <Border Grid.Column="1"
                                Background="#F7F7F7"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8">
                            <TextBlock x:Name="tbFullName"
                                       Text=""
                                       Foreground="#222222"/>
                        </Border>
                    </Grid>
                    <Grid Margin="0 5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Телефон:"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Foreground="#333333"/>
                        <Border Grid.Column="1"
                                Background="#F7F7F7"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8">
                            <TextBlock x:Name="tbPhone"
                                       Text=""
                                       Foreground="#222222"/>
                        </Border>
                    </Grid>
                    <Grid Margin="0 5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Email:"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Foreground="#333333"/>
                        <Border Grid.Column="1"
                                Background="#F7F7F7"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8">
                            <TextBlock x:Name="tbEmail"
                                       Text=""
                                       Foreground="#222222"/>
                        </Border>
                    </Grid>
                    <Grid Margin="0 5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Дата рождения:"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Foreground="#333333"/>
                        <Border Grid.Column="1"
                                Background="#F7F7F7"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8">
                            <TextBlock x:Name="tbBirthDate"
                                       Text=""
                                       Foreground="#222222"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            <Button Content="Каталог товаров"
                    Style="{StaticResource ButtonStyle}"
                    Click="BtnCatalog_Click" Width="311"/>
            <Button Content="Корзина"
                    Style="{StaticResource ButtonStyle}"
                    Click="BtnCart_Click" Width="311"/>
            <Button Content="График работы"
                    Style="{StaticResource ButtonStyle}"
                    Click="BtnSchedule_Click" Width="311"/>
            <Button Content="Назад"
                    Style="{StaticResource ButtonStyle}"
                    Click="BtnBack_Click" Width="311"/>
            
        </StackPanel>
    </Grid>
</Window>