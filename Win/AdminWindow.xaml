<Window x:Class="Pizza.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Администратор" Height="420" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="DarkOrange">
    <Grid>
        <Border Width="350"
                Background="White"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="25"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Панель администратора"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 25"/>
                <Button Content="Управление товарами"
                        Height="38"
                        Margin="0 5"
                        Click="BtnProducts_Click"/>
                <Button Content="Добавить сотрудника"
                        Height="38"
                        Margin="0 5"
                        Click="BtnAddEmployee_Click"/>
                <Button Content="История заказов"
                        Height="38"
                        Margin="0 5"
                        Click="BtnOrderHistory_Click"/>
                <Button Content="График работы"
        Height="38"
        Margin="0 5"
        Click="BtnSchedule_Click"/>
                <Button Content="Назад"
                        Height="38"
                        Margin="0 20 0 0"
                        Click="BtnBack_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>