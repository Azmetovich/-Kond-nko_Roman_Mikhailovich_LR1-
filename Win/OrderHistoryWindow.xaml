<Window x:Class="Pizza.OrderHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История заказов" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F2F2F2">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="История заказов"
                   FontSize="26"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0 0 0 20"/>
        <ListView x:Name="LViewOrders"
                  Grid.Row="1"
                  BorderThickness="0"
                  Background="Transparent">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0 0 0 10"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="White"
                            BorderBrush="#D0D0D0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding ReceiptNumberText}"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding OrderDateText}"
                                       FontSize="14"
                                       Margin="0 5 0 0"/>
                            <TextBlock Text="{Binding EmployeeName}"
                                       FontSize="14"
                                       Margin="0 5 0 0"/>
                            <TextBlock Text="{Binding ProductsText}"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0 5 0 0"/>
                            <TextBlock Text="{Binding TotalPriceText}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Margin="0 5 0 0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Grid.Row="2"
                Content="Назад"
                Width="120"
                Height="35"
                HorizontalAlignment="Center"
                Margin="0 15 0 0"
                Click="BtnBack_Click"/>
    </Grid>
</Window>