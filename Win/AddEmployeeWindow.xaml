<Window x:Class="Pizza.AddEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление сотрудника" Height="680" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="DarkOrange">
    <Grid>
        <Border Width="360"
                Background="White"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Добавление сотрудника"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 20"/>
                <TextBlock Text="Фамилия"/>
                <TextBox x:Name="TBoxLastName" Height="30" Margin="0 5 0 10"/>
                <TextBlock Text="Имя"/>
                <TextBox x:Name="TBoxFirstName" Height="30" Margin="0 5 0 10"/>
                <TextBlock Text="Отчество"/>
                <TextBox x:Name="TBoxMiddleName" Height="30" Margin="0 5 0 10"/>
                <TextBlock Text="Телефон"/>
                <TextBox x:Name="TBoxPhone" Height="30" Margin="0 5 0 10"/>
                <TextBlock Text="Email"/>
                <TextBox x:Name="TBoxEmail" Height="30" Margin="0 5 0 10"/>
                <TextBlock Text="Дата рождения"/>
                <DatePicker x:Name="DPBirthDate" Height="30" Margin="0 5 0 10"/>
                <TextBlock Text="Логин"/>
                <TextBox x:Name="TBoxLogin" Height="30" Margin="0 5 0 10"/>
                <TextBlock Text="Пароль"/>
                <PasswordBox x:Name="PBoxPassword" Height="30" Margin="0 5 0 15"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Сохранить"
                            Width="120"
                            Height="35"
                            Margin="5"
                            Click="BtnSave_Click"/>
                    <Button Content="Назад"
                            Width="120"
                            Height="35"
                            Margin="5"
                            Click="BtnBack_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>