<Window x:Class="Pizza.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Корзина" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F2F2F2">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Корзина"
                   FontSize="26"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0 0 0 20"/>
        <ListBox x:Name="CartList"
                 Grid.Row="1"
                 BorderThickness="0"
                 Background="Transparent">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0 0 0 10"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White"
                            BorderBrush="#D0D0D0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding ProductName}"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding Description}"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0 5 0 0"/>
                            <TextBlock Text="{Binding Ingredients}"
                                       FontSize="12"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"
                                       Margin="0 5 0 0"/>
                            <TextBlock Text="{Binding PriceText}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Margin="0 5 0 0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0 15 0 0">
            <Button Content="Удалить товар"
                    Width="130"
                    Height="35"
                    Margin="5"
                    Click="BtnDelete_Click"/>
            <Button Content="Купить"
                    Width="120"
                    Height="35"
                    Margin="5"
                    Click="BtnBuy_Click"/>
            <Button Content="Назад"
                    Width="120"
                    Height="35"
                    Margin="5"
                    Click="BtnBack_Click"/>
            <TextBlock x:Name="tbTotalPrice"
                       Text="Итого: 0.00 руб."
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="20 0 0 0"/>
        </StackPanel>
    </Grid>
</Window>