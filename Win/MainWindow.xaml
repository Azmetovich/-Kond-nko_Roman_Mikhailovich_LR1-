<Window x:Class="Pizza.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="300" Width="400"
        Background="LightSteelBlue"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <StackPanel Width="250" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Авторизация"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0 0 0 25"/>

            <TextBlock Text="Логин" FontWeight="Bold"/>
            <TextBox x:Name="TBoxLogin"
                     Height="30"
                     Padding="5 5 0 0"
                     Margin="0 5 0 15"/>

            <TextBlock Text="Пароль" FontWeight="Bold"/>
            <PasswordBox x:Name="PBoxPassword"
                         Height="30"
                         Padding="5 5 0 0"
                         Margin="0 5 0 20"/>

            <Button Content="Войти"
                    Height="35"
                    FontWeight="Bold"
                    
                    Click="BtnLogin_Click" Width="217"/>
        </StackPanel>
    </Grid>
</Window>